# 环境与密钥
.env
.venv/

# Python 产物
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 采集原始数据（体积大，不入库；本地/runner 上保留 90 天后自动清理）
data/raw/

# data/trends.db 与 data/processed/ 需要入库：daily-collect.yml 每天把当天快照回写仓库，
# Streamlit Cloud 部署依赖仓库里的这些文件。这里只忽略 SQLite 的临时文件。
data/*.db-journal
data/*.db-wal
data/*.db-shm

# 编辑器
.idea/
.vscode/
